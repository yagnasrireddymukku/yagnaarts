# Build output — regenerated by `npm run build` from /src + /data.
# Kept out of version control so /src stays the single source of truth;
# CI (Phase 15) runs the build before deploying.
/pages/
/product/
/collections/
/blog/
/index.html
/404.html
/sitemap.xml
# /robots.txt is NOT listed here — it's hand-authored static content, not build output
# (/src/pages, /src/components, /src/templates are NOT matched by the
# patterns above — those are hand-authored source, always tracked)

# OS / editor cruft
.DS_Store
Thumbs.db
*.log

# Node (no runtime deps today, but future-proofed)
node_modules/

# Local env files (Phase 11 form integrations — EmailJS keys, etc.)
.env
.env.local

# Claude Code local project settings — machine-specific, not for the repo
.claude/

# Local Netlify folder
.netlify
